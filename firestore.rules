rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // Multi-Tenant & Role-Based Access Control (RBAC) Helpers
    // ─────────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Role extraction supporting both Firebase Auth custom claims and Firestore profile
    function getRole() {
      return ('role' in request.auth.token && request.auth.token.role != null)
        ? request.auth.token.role 
        : (userExists(request.auth.uid) ? userDoc(request.auth.uid).role : '');
    }

    // Tenant Organization ID extraction
    function getOrgId() {
      return ('orgId' in request.auth.token && request.auth.token.orgId != null)
        ? request.auth.token.orgId 
        : (userExists(request.auth.uid) ? userDoc(request.auth.uid).orgId : null);
    }

    function isSameTenant(orgId) {
      return getOrgId() != null && getOrgId() == orgId;
    }

    function isSuperAdmin() {
      return signedIn() && (
        ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
        getRole() in [
          'super_admin', 'SUPER_ADMIN', 'super admin', 'Super Admin', 'superadmin'
        ]
      );
    }

    function isStaff() {
      return signedIn() && (
        isSuperAdmin() ||
        getRole() in [
          'admin', 'Admin', 'hrms', 'HRMS', 'hr', 'HR', 'hradmin', 'HR Admin',
          'manager', 'Manager'
        ]
      );
    }

    // ─────────────────────────────────────────────────────────────────
    // REQUIREMENT: Route Protection Gate
    // Super Admins must have orgConfigured == true in their organization
    // document before accessing ANY administrative collections.
    // ─────────────────────────────────────────────────────────────────
    function isOrgConfigured(orgId) {
      return orgId != null 
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.orgConfigured == true;
    }

    function canAccessAdmin() {
      let orgId = getOrgId();
      return signedIn() && isSuperAdmin() && isOrgConfigured(orgId);
    }

    function canAccessStaff() {
      let orgId = getOrgId();
      return signedIn() && isStaff() && (isOrgConfigured(orgId) || !isSuperAdmin());
    }

    function ownsEmployeeId(employeeId) {
      return signedIn() && (
        request.auth.uid == employeeId
        || (
          userExists(employeeId)
          && (
            userDoc(employeeId).linkedAuthUid == request.auth.uid
            || userDoc(employeeId).email == request.auth.token.email
          )
        )
      );
    }

    // ─────────────────────────────────────────────────────────────────
    // Tenant isolation for top-level collections: every document carries an
    // `orgId`, and a user may only read/write documents of their own org.
    // (firebase-config.js adds the matching where('orgId','==',…) filter to
    // queries and stamps orgId on new documents.)
    // ─────────────────────────────────────────────────────────────────
    function tenantRead() {
      return signedIn() && getOrgId() != null && resource.data.orgId == getOrgId();
    }

    function tenantCreate() {
      return signedIn() && getOrgId() != null && request.resource.data.orgId == getOrgId();
    }

    // Existing doc must be ours and orgId may not be changed
    function tenantUpdate() {
      return tenantRead() && request.resource.data.orgId == resource.data.orgId;
    }

    // ─────────────────────────────────────────────────────────────────
    // Organizations Collection & Subcollections (Multi-Tenant Hub)
    // ─────────────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      // Super Admins can read & update their organization even before orgConfigured is true
      // (This enables the setup wizard to complete company configurations and flip the flag)
      // Only members of the org can read it (a super admin of another org cannot)
      allow read: if signedIn() && isSameTenant(orgId);
      allow update: if signedIn() && isSuperAdmin() && isSameTenant(orgId);
      // Organizations are created by the backend signup (Admin SDK), never by clients
      allow create: if false;
      allow delete: if false; // Organization root docs cannot be deleted by client

      // Sequential Distributed Counter: Read-only to staff, mutated only by transactional Cloud Functions
      match /counters/{counterId} {
        allow read: if signedIn() && isSameTenant(orgId) && isStaff();
        allow write: if false; 
      }

      // Audit logs: Append-only via backend Cloud Functions
      match /audit_logs/{logId} {
        allow read: if canAccessAdmin() && isSameTenant(orgId);
        allow write: if false;
      }

      // Provisioned Employees
      match /employees/{empId} {
        allow read: if signedIn() && isSameTenant(orgId) && (isStaff() || ownsEmployeeId(empId));
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Statutory Compliance Rules (PRD §§ 1, 4, 11, & 13)
      match /statutory_rules/{complianceCode} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Hybrid RBAC Base Roles (PRD §§ 1, 14, 17, & 18)
      match /roles/{roleCode} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Employee-Specific Permission Overrides (PRD §§ 1, 14, 17, & 18)
      match /user_permission_overrides/{employeeId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Cached User Permissions
      match /user_permissions/{userId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Multi-Step Workflow Automation Chains (PRD §§ 1, 9, 12, 14, & 18)
      match /workflows/{workflowCode} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Payroll Components Catalog (PRD §§ 1 & 4)
      // Path: organizations/{orgId}/payroll_components/{componentCode}
      match /payroll_components/{componentCode} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      match /workflow_instances/{instanceId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if signedIn() && isSameTenant(orgId);
      }

      match /approval_tasks/{taskId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if signedIn() && isSameTenant(orgId);
      }

      // Statutory Profiles (PRD §§ 1, 4, 11, & 13)
      match /employee_pt_details/{employeeId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      match /employee_esic_details/{employeeId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      match /employee_pf_details/{employeeId} {
        allow read: if signedIn() && isSameTenant(orgId);
        allow write: if canAccessAdmin() && isSameTenant(orgId);
      }

      // Any other org-owned configuration (business_units, cost_centers, shifts,
      // employee_types, employee_finance, sub_departments, ...): same org only
      // (Explicitly matched subcollections above are excluded so this never loosens them.)
      function isExplicitSubCollection(name) {
        return name in [
          'counters', 'audit_logs', 'employees', 'statutory_rules', 'roles',
          'user_permission_overrides', 'user_permissions', 'workflows', 'payroll_components',
          'workflow_instances', 'approval_tasks', 'employee_pt_details',
          'employee_esic_details', 'employee_pf_details'
        ];
      }

      match /{subCollection}/{docId} {
        allow read: if signedIn() && isSameTenant(orgId) && !isExplicitSubCollection(subCollection);
        allow write: if isStaff() && isSameTenant(orgId) && !isExplicitSubCollection(subCollection);
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // Top-level collections. Every rule below is AND-ed with the tenant
    // check (tenantRead / tenantCreate / tenantUpdate), so an admin of one
    // organization can never read or write another organization's data.
    // Subcollections are checked through their parent document's orgId.
    // ─────────────────────────────────────────────────────────────────
    function parentInTenant(parentPath) {
      return signedIn() && getOrgId() != null && exists(parentPath)
        && get(parentPath).data.orgId == getOrgId();
    }

    // Administrative Collections (GATED: Requires orgConfigured == true)

    // Master Company Settings & Command Center
    match /admin_settings/{settingId} {
      allow read: if canAccessAdmin() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if canAccessAdmin() && tenantRead();
    }

    match /command_centers/{centerId} {
      allow read: if tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if canAccessAdmin() && tenantRead();
    }

    // Platform-wide configuration shared by all organizations
    match /system_config/{configId} {
      allow read: if signedIn();
      allow write: if false; // managed by the backend (Admin SDK) only
    }

    match /workflow_rules/{ruleId} {
      allow read: if isStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if canAccessAdmin() && tenantRead();
    }

    // Payroll Documents
    match /payroll_documents/{docId} {
      allow read: if tenantRead() && (canAccessAdmin() || ownsEmployeeId(resource.data.employeeId));
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if canAccessAdmin() && tenantRead();
    }

    // Statutory Policy Configurations (Versioned Master Rules)
    match /statutory_policy_configs/{configId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if false; // Policy history must never be deleted
    }

    // Payroll Runs (Independent lifecycle for calculation)
    match /payroll_runs/{runId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate() && (
        resource.data.status != 'LOCKED' || request.resource.data.status == 'ARCHIVED'
      );
      allow delete: if false;
    }

    // Payment Batches (Disbursement lifecycle & 4-Eyes Check)
    match /payment_batches/{batchId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      // Maker cannot be Checker (4-Eye rule enforcement)
      allow update: if canAccessAdmin() && tenantUpdate() && (
        !(request.resource.data.maker_checker.checker_id != null &&
          request.resource.data.maker_checker.checker_id == resource.data.maker_checker.maker_id)
      );
      allow delete: if canAccessAdmin() && tenantRead() && resource.data.status in ['DRAFT', 'VALIDATION_FAILED'];

      match /records/{recordId} {
        allow read: if parentInTenant(/databases/$(database)/documents/payment_batches/$(batchId))
          && (canAccessStaff() || ownsEmployeeId(resource.data.employee_id));
        allow write: if canAccessAdmin() && parentInTenant(/databases/$(database)/documents/payment_batches/$(batchId));
      }
    }

    // Compliance Returns (PF ECR, ESIC, Gratuity, NPS)
    match /compliance_returns/{returnId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if false;
    }

    match /statutory_exceptions/{exceptionId} {
      allow read: if canAccessAdmin() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if canAccessAdmin() && tenantRead();
    }

    // Bank Files & Reconciliation Audit Logs
    match /bank_files/{fileId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update, delete: if false; // Tamper-proof bank files
    }

    match /bank_reconciliations/{recId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update: if canAccessAdmin() && tenantUpdate();
      allow delete: if false;
    }

    match /disbursement_logs/{logId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessAdmin() && tenantCreate();
      allow update, delete: if false; // Append-only audit logs
    }

    // Recruitment ATS
    match /candidates/{candidateId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessStaff() && tenantCreate();
      allow update: if canAccessStaff() && tenantUpdate();
      allow delete: if canAccessStaff() && tenantRead();

      match /interviews/{interviewId} {
        allow read, write: if canAccessStaff()
          && parentInTenant(/databases/$(database)/documents/candidates/$(candidateId));
      }
    }

    match /recruitment_events/{eventId} {
      allow read: if canAccessStaff() && tenantRead();
      allow create: if canAccessStaff() && tenantCreate();
      allow update: if canAccessStaff() && tenantUpdate();
      allow delete: if canAccessStaff() && tenantRead();
    }

    // ─────────────────────────────────────────────────────────────────
    // Users & Compliance Profiles
    // ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile, or profiles in the same organization
      allow read: if signedIn() && (request.auth.uid == userId || tenantRead());
      // Restrict create so a new doc cannot set role above 'Employee'
      allow create: if signedIn() && (
        (canAccessAdmin() && tenantCreate()) || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role in ['Employee', 'employee']) &&
          (!('super_admin' in request.resource.data) || request.resource.data.super_admin != true)
        )
      );
      // A user cannot modify role, orgId, linkedAuthUid, or super_admin on their own profile
      allow update: if (canAccessAdmin() && tenantUpdate()) || (
        signedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'orgId', 'linkedAuthUid', 'super_admin'])
      );
      allow delete: if canAccessAdmin() && tenantRead();

      match /compliance_profile/{profileId} {
        allow read: if parentInTenant(/databases/$(database)/documents/users/$(userId))
          && (canAccessStaff() || ownsEmployeeId(userId));
        allow write: if canAccessAdmin() && parentInTenant(/databases/$(database)/documents/users/$(userId));
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // PRD Section 10: Business Unit by Employee Type Rules
    // ─────────────────────────────────────────────────────────────────
    match /bu_employee_type_rules/{ruleId} {
      allow read: if tenantRead();
      allow create: if isStaff() && tenantCreate();
      allow update: if isStaff() && tenantUpdate();
      allow delete: if isStaff() && tenantRead();
    }

    // ─────────────────────────────────────────────────────────────────
    // PRD Section 11: Alert Trigger Registry (Safe Simulation Mode)
    // ─────────────────────────────────────────────────────────────────
    match /alert_trigger_registry/{triggerId} {
      allow read: if tenantRead();
      allow create: if isStaff() && tenantCreate();
      allow update: if isStaff() && tenantUpdate();
      allow delete: if isStaff() && tenantRead();
    }

    // ─────────────────────────────────────────────────────────────────
    // PRD Section 12: Workflows & Direct Automation Configuration
    // ─────────────────────────────────────────────────────────────────
    match /workflows/{workflowId} {
      allow read: if tenantRead();
      allow create: if isStaff() && tenantCreate();
      allow update: if isStaff() && tenantUpdate();
      allow delete: if isStaff() && tenantRead();

      match /automation_configs/{stageId} {
        allow read: if parentInTenant(/databases/$(database)/documents/workflows/$(workflowId));
        allow write: if isStaff() && parentInTenant(/databases/$(database)/documents/workflows/$(workflowId));
      }

      match /question_configs/{stageId} {
        allow read: if parentInTenant(/databases/$(database)/documents/workflows/$(workflowId));
        allow write: if isStaff() && parentInTenant(/databases/$(database)/documents/workflows/$(workflowId));
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // PRD Section 13: Employee Master, Job Details & Official Documents
    // ─────────────────────────────────────────────────────────────────
    match /employees/{employeeId} {
      allow read: if tenantRead();
      allow create: if isStaff() && tenantCreate();
      allow update: if isStaff() && tenantUpdate();
      allow delete: if isStaff() && tenantRead();

      match /documents/{docId} {
        allow read: if parentInTenant(/databases/$(database)/documents/employees/$(employeeId));
        allow write: if isStaff() && parentInTenant(/databases/$(database)/documents/employees/$(employeeId));
      }
    }

    // PRD Section 14: Manager Assignment Audit Trail (append-only)
    match /audit_logs/{logId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
    }

    // Every other top-level collection (attendance, notifications, messages,
    // payroll_profiles, holidays, ...): same organization only. Collections with
    // an explicit rule above are excluded so this fallback never loosens them.
    match /{collection}/{document} {
      allow read: if tenantRead() && !isExplicitCollection(collection);
      allow create: if tenantCreate() && !isExplicitCollection(collection);
      allow update: if tenantUpdate() && !isExplicitCollection(collection);
      allow delete: if tenantRead() && !isExplicitCollection(collection);
    }

    function isExplicitCollection(name) {
      return name in [
        'organizations', 'admin_settings', 'command_centers', 'system_config', 'workflow_rules',
        'payroll_documents', 'statutory_policy_configs', 'payroll_runs', 'payment_batches',
        'compliance_returns', 'statutory_exceptions', 'bank_files', 'bank_reconciliations',
        'disbursement_logs', 'candidates', 'recruitment_events', 'users',
        'bu_employee_type_rules', 'alert_trigger_registry', 'workflows', 'employees', 'audit_logs'
      ];
    }
  }
}
