# =====================================================================================
# Kylrx environment variables. Copy to .env (never commit .env) or set them in your host.
# Check with: npm run check:env            (development)
#             npm run check:env -- --mode=production
# Values here are placeholders. Required = the app refuses to start (or a feature cannot work) without it.
# =====================================================================================

# ---- Runtime --------------------------------------------------------------------------
# development | production | test. Production turns on every required check below.  [required in production]
NODE_ENV=development
# HTTP port of the Express server.  [optional, default 3000]
PORT=3000
# Public URL of the app, used in links inside emails (onboarding invites, password setup).  [required in production]
APP_URL=https://hr.example.com
# Extra browser origins allowed by CORS in production, comma-separated (your own domains).
# <FIREBASE_PROJECT_ID>.web.app and .firebaseapp.com are always allowed.  [optional, recommended in production]
ALLOWED_ORIGINS=https://hr.example.com

# ---- Authentication ---------------------------------------------------------------------
# Signing keys for the app's own JWTs. Long random strings (32+ characters), different from each other.  [required in every mode]
JWT_SECRET=CHANGE_ME_random_string_at_least_32_characters
REFRESH_SECRET=CHANGE_ME_another_random_string_at_least_32_chars
# Development only: lets the dev identity sign in without a real token. Ignored in production.  [optional, default off]
ALLOW_DEV_IDENTITY=false
# Organization used for legacy data without an orgId, and for the dev identity.  [optional, default org_kylrx_ai]
DEV_DEFAULT_ORG_ID=

# ---- Firebase project (server) --------------------------------------------------------------
# Your Firebase project id, e.g. acme-hr-prod.  [required in production; in development the service account's project is used]
FIREBASE_PROJECT_ID=CHANGE_ME
# Your default Storage bucket, e.g. acme-hr-prod.firebasestorage.app.  [required in production]
FIREBASE_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
# Optional: auth domain for the /__/auth proxy if it is not <FIREBASE_PROJECT_ID>.firebaseapp.com.  [optional]
FIREBASE_AUTH_DOMAIN=
# Service account (Firebase console > Project settings > Service accounts > Generate new private key).
# Set ONE of the two. Prefer the host's secret store over a file. Never commit the key.  [required in production]
# FIREBASE_SERVICE_ACCOUNT holds the key JSON itself (raw or base64).
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH is a path to the key file, relative to the project root.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Set automatically by the emulator scripts (npm run start:local, test:rules, ...). Do not set it by hand.  [optional]
FIRESTORE_EMULATOR_HOST=
# Set by npm run start:local: local test database mode (no real emails).  [optional]
KYLRX_LOCAL_DB=
# Multi-tenant read isolation on the server: on after scripts/migrate-tenant-orgid.js --apply.  [optional, default off]
TENANT_READ_SCOPING=off

# ---- Exports and payroll disbursement (Decentro) ----------------------------------------------
# Key that signs exported statutory / bank files. Long random string (32+ characters).  [required in production]
KYLRX_EXPORT_SIGNING_KEY=CHANGE_ME_random_string_at_least_32_characters
# Decentro API base URL. The code falls back to the STAGING URL when unset.  [required in production]
DECENTRO_BASE_URL=https://CHANGE_ME.decentro.tech/fabric
# Decentro credentials (from your Decentro account).  [required in production]
DECENTRO_CLIENT_ID=CHANGE_ME
DECENTRO_CLIENT_SECRET=CHANGE_ME
DECENTRO_MODULE_SECRET=CHANGE_ME
DECENTRO_PROVIDER_SECRET=CHANGE_ME

# ---- Email -------------------------------------------------------------------------------------
# Sender address for outgoing email (falls back to SMTP_USER).  [recommended in production]
EMAIL_FROM=hr@example.com
# Display name of the sender.  [optional, default "Kylrx AI HRMS"]
EMAIL_SENDER_NAME=Your Company HR
# SMTP account (e.g. an app password for Gmail / Workspace). Email features need SMTP or Resend.  [recommended in production]
SMTP_USER=hr@example.com
SMTP_PASS=
# Resend API key, an alternative to SMTP.  [optional]
RESEND_API_KEY=

# ---- AI (optional) --------------------------------------------------------------------------------
# OpenAI key for the Automation Builder; without it the rule-based fallback is used.  [optional]
OPENAI_API_KEY=
# OpenAI model name.  [optional]
OPENAI_MODEL=gpt-4o-mini

# ---- First super admin (scripts/provision-superadmin.js only) -----------------------------------
# Read only by the provisioning script, never by the server. See README.md "First super admin".  [optional]
SUPERADMIN_PASSWORD=

# ---- Local tools ---------------------------------------------------------------------------------
# Browser-side API base for pages served from another origin; same-origin is used when unset.  [optional]
API_BASE=
# Backend port the dev static server (tools/start_5500_server.js) proxies /api/* to.  [optional, default 3000]
API_PORT=3000
# Interface the dev static server listens on.  [optional, default 127.0.0.1]
STATIC_HOST=127.0.0.1
